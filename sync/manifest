# sync/manifest -- what this repository takes from SPEAR, and where it lives here.
# Read by sync/spear_sync.py (sync/README.md). Three kinds of line:
#   map     <SPEAR path> <local path>          a file, or a directory and everything under it
#   exclude <glob> ...                         left out wherever it matches (a path or one path element)
#   rewrite <local glob> <from> <to>           the only allowed local differences: applied on
#                                              pull, reversed on push. Keep them few and specific.
# Files not reached by a `map` (the top README/AGENTS, the board Makefiles, sync/) are local only.

# ---- FPGA IP: the UHD data-plane cores, the CMAC wrapper, the dual RF-ADC I/Q joiners
# (SPEAR's ZCU208 ones; the RFSoC 4x2 design uses them).
# Same relative layout as SPEAR's hw_design/{ip_design,ip}, so the packaging and
# build scripts find each other unchanged.
map hw_design/ip_design/uhd_ip                                fpga_ip/ip_design/uhd_ip
map hw_design/ip_design/cmac_100g                             fpga_ip/ip_design/cmac_100g
map hw_design/ip/uhd_ip                                       fpga_ip/ip/uhd_ip
map hw_design/ip/iprepo/dual_rf_adc_iq_merger_1.0             fpga_ip/ip/iprepo/dual_rf_adc_iq_merger_1.0
map hw_design/ip/iprepo/dual_channel_rf_adc_iq_packer_1.0     fpga_ip/ip/iprepo/dual_channel_rf_adc_iq_packer_1.0

# ---- FPGA boards: one self-contained block design (tcl + xdc) per board, and its build flow
map hw_design/ZCU216/block_designs/zcu216_v49_qsfp/zcu216_v49_qsfp.tcl  fpga_board/zcu216/block_designs/zcu216_uhd_v49/zcu216_uhd_v49.tcl
map hw_design/ZCU216/block_designs/zcu216_v49_qsfp/zcu216_v49_qsfp.xdc  fpga_board/zcu216/block_designs/zcu216_uhd_v49/zcu216_uhd_v49.xdc
map hw_design/ZCU216/scripts/v49_build.tcl                    fpga_board/zcu216/scripts/v49_build.tcl
map hw_design/ZCU216/scripts/v49_ladder.sh                    fpga_board/zcu216/scripts/v49_ladder.sh
# The RFSoC 4x2 (fpga_board/rfsoc4x2) is local: SPEAR has no design for it (its ZCU208
# v49 port is not taken; the 4x2 design started from it).

# ---- host: the UHD device module, its tools, benchmarks and flowgraphs (the PC side)
map rfsoc_lib/uhd/host                                        host
map rfsoc_lib/uhd/benchmark                                   host/benchmark
map rfsoc_lib/uhd/gnuradio                                    host/gnuradio
map rfsoc_lib/uhd/PROTOCOL.md                                 PROTOCOL.md

# ---- rfsoc: the PYNQ side -- the board daemon and the rfsoc_lib modules it imports
map rfsoc_lib/uhd/server                                      rfsoc/server
map rfsoc_lib/__init__.py                                     rfsoc/rfsoc_lib/__init__.py
map rfsoc_lib/clk_wiz.py                                      rfsoc/rfsoc_lib/clk_wiz.py
map rfsoc_lib/clocks.py                                       rfsoc/rfsoc_lib/clocks.py
map rfsoc_lib/gt_refclk.py                                    rfsoc/rfsoc_lib/gt_refclk.py
map rfsoc_lib/mts.py                                          rfsoc/rfsoc_lib/mts.py
map rfsoc_lib/overlay_task.py                                 rfsoc/rfsoc_lib/overlay_task.py
map rfsoc_lib/rfdc.py                                         rfsoc/rfsoc_lib/rfdc.py
map rfsoc_lib/rfdc_config.py                                  rfsoc/rfsoc_lib/rfdc_config.py
map rfsoc_lib/rfdc_task.py                                    rfsoc/rfsoc_lib/rfdc_task.py
map rfsoc_lib/rfdc_type.py                                    rfsoc/rfsoc_lib/rfdc_type.py
map rfsoc_lib/rfsoc_overlay.py                                rfsoc/rfsoc_lib/rfsoc_overlay.py
map rfsoc_lib/txt_logger.py                                   rfsoc/rfsoc_lib/txt_logger.py
map rfsoc_lib/dsp/beamformer.py                               rfsoc/rfsoc_lib/dsp/beamformer.py
map rfsoc_lib/dsp/phase_search.py                             rfsoc/rfsoc_lib/dsp/phase_search.py
map rfsoc_lib/dsp/unit_convt.py                               rfsoc/rfsoc_lib/dsp/unit_convt.py
map rfsoc_lib/xrfclk                                          rfsoc/rfsoc_lib/xrfclk

# ---- never taken: build output, tool logs, editor and Python droppings
exclude build build-* *.log *.jou *.backup.* .Xil __pycache__ *.pyc results/*/
# ---- the ZCU208 is not supported here: its clock files and oracle list stay in SPEAR.
# Files only here inside mapped trees (xrfclk/RFSoC4x2/LMX2594_250.0_5000.0.txt,
# host/benchmark/oracle_builds_rfsoc4x2.txt) are local: status / push ignore them.
exclude ZCU208 oracle_builds_zcu208.txt

# ---- rewrites: the board designs carry this repository's names (zcu2xx_uhd_v49; the
# block design inside is still named zcu2xx_v49_<N>ch_qsfp, so bitstreams are
# unchanged), and the flow finds the IP under fpga_ip/ instead of next to the
# board directories. Rules must not overlap: push reverses them one by one.
rewrite fpga_board/zcu216/*  "zcu216_v49_qsfp" "zcu216_uhd_v49"
rewrite fpga_board/zcu216/scripts/v49_build.tcl "set hwd         [file normalize $zcu216/..]" "set hwd         [file normalize $zcu216/../../fpga_ip]"
# host tools next to the benchmarks: SPEAR has them in ../host/tools
rewrite host/benchmark/*.sh  "$HERE/../host/tools" "$HERE/../tools"
# Python helpers that reach across the tree
rewrite host/benchmark/phase_cal.py  "os.path.join(os.path.dirname(__file__), \"..\", \"..\", \"..\")" "os.path.join(os.path.dirname(__file__), \"..\", \"..\", \"rfsoc\")"
rewrite host/tools/check_pattern_file.py  "'..', '..', 'server'" "'..', '..', 'rfsoc', 'server'"
# The board runs this repository as a git checkout (/home/xilinx/jupyter_notebooks/rfsoc-uhd,
# README "Board"), not SPEAR's deployed layout: the daemon is rfsoc/server there.
# (Generic rule first, then the one on its result: push reverses them in order.)
rewrite host/benchmark/oracle.sh          "jupyter_notebooks/SPEAR-qsfpv" "jupyter_notebooks/rfsoc-uhd"
rewrite rfsoc/server/zcu216-uhd.service   "jupyter_notebooks/SPEAR-qsfpv" "jupyter_notebooks/rfsoc-uhd"
rewrite rfsoc/server/zcu216-uhd.service   "rfsoc-uhd/rfsoc_lib/uhd/server" "rfsoc-uhd/rfsoc/server"
rewrite host/benchmark/oracle.sh          "SRV=$BOARD_DIR/rfsoc_lib/uhd/server" "SRV=$BOARD_DIR/rfsoc/server"
rewrite host/benchmark/oracle.sh          "where server/deploy.sh put rfsoc_lib on the board" "the board's git checkout of this repository"
rewrite host/benchmark/loopback_test.py   "os.path.join(HERE, \"..\", \"server\")" "os.path.join(HERE, \"..\", \"..\", \"rfsoc\", \"server\")"
