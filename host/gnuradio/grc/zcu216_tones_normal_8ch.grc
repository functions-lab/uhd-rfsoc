options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'ZCU216 normal 8ch (zcu216_v49_8ch_qsfp_f4_fs2500): timed tone bursts,
      captured on every channel'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: zcu216_tones_normal_8ch
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: /bin/bash -c 'exec pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY"
      /usr/local/bin/zcu216-uhd "$0" -u "$1"' {python} {filename}
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ZCU216 normal 8ch tones (312.5 MS/s, otw sc16), TX phase / amplitude per
      channel
    window_size: (1400,1100)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: burst_len
  id: variable
  parameters:
    comment: ''
    value: '16384'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 96]
    rotation: 0
    state: enabled
- name: cap_len
  id: variable
  parameters:
    comment: ''
    value: '8192'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 96]
    rotation: 0
    state: enabled
- name: cap_offset
  id: variable
  parameters:
    comment: ''
    value: burst_len // 4
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 96]
    rotation: 0
    state: enabled
- name: dev_args
