- name: bursts
  id: snippet
  parameters:
    alias: ''
    code: "from PyQt5 import Qt as _Qt\n# open on the TX phase sliders: after show(),\
      \ which focuses a slider and so its tab\n_Qt.QTimer.singleShot(200, lambda tb=self:\
      \ tb.ctrl.setCurrentIndex(0))\nimport os, threading, time as _time\nimport pmt\n\
      from gnuradio import uhd as _uhd\nfrom PyQt5 import Qt as _Qt\n# burst mode:\
      \ stop the continuous stream gr-uhd starts with the flowgraph, then\n# every\
      \ period one TX burst at device time t0 and one RX capture inside it\n_src =\
      \ self.usrp_source\n_src.issue_stream_cmd(_uhd.stream_cmd_t(_uhd.STREAM_MODE_STOP_CONTINUOUS))\n\
      self.bursts_sent = 0\ndef _bursts(tb=self):\n    _time.sleep(2.0)   # let the\
      \ flowgraph and the GUI settle: the first bursts were late\n    while True:\n\
      \        t0 = _src.get_time_now().get_real_secs() + tb.lead\n        tb.tones._post(pmt.intern(\"\
      fire\"), pmt.from_double(t0))\n        cmd = _uhd.stream_cmd_t(_uhd.STREAM_MODE_NUM_SAMPS_AND_DONE)\n\
      \        cmd.num_samps = tb.cap_len\n        cmd.stream_now = False\n      \
      \  cmd.time_spec = _uhd.time_spec(t0 + tb.cap_offset / tb.samp_rate)\n     \
      \   _src.issue_stream_cmd(cmd)\n        tb.bursts_sent += 1\n        _time.sleep(tb.period)\n\
      threading.Thread(target=_bursts, daemon=True).start()\n# ZCU216_GR_SNAPSHOT=<png>:\
      \ save the window after ZCU216_GR_SNAPSHOT_S (default 6) s and quit\n_snap =\
      \ os.environ.get(\"ZCU216_GR_SNAPSHOT\")\nif _snap:\n    self.resize(1600, 600)\n\
      \    def _shot(tb=self):\n        tb.grab().save(_snap)\n        print(f\"snapshot\
      \ {_snap} after {tb.bursts_sent} bursts\", flush=True)\n        tb.close()\n\
      \    _Qt.QTimer.singleShot(int(1000 * float(os.environ.get(\"ZCU216_GR_SNAPSHOT_S\"\
      , \"6\"))), _shot)\n"
    comment: ''
    priority: '0'
    section: main_after_start
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 8]
    rotation: 0
    state: enabled
