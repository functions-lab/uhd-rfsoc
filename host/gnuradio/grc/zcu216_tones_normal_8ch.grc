- name: tones
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python block (GRC epy_block) of the zcu216_tones_*\
      \ flowgraphs:\none timed TX burst per message on the `fire` port, the same tone\
      \ on every\nchannel, each with its own phase and amplitude (`phases_deg`, `amps`).\n\
      \nChannel k carries amps[k] x exp(j phases_deg[k] pi / 180) x exp(j 2 pi tone_step\
      \ n) (tone_step: the tone as\na fraction of the sample rate; the flowgraphs\
      \ pass tone / samp_rate, 10 MHz\nby default). A message on `fire` (a pmt\ndouble:\
      \ the device time t0, seconds) queues one burst of `burst_len` samples\nper\
      \ channel, tagged for gr-uhd's USRP Sink on output 0: tx_sob + tx_time (t0)\n\
      on its first sample, tx_eob on its last. Between bursts the block emits\nnothing,\
      \ so the sink sends nothing.\n\nThe burst is requested by message, not by a\
      \ method call, because a message\nwakes the block's thread at once: a source\
      \ block that returned 0 items is\notherwise left idle for up to 250 ms by GNU\
      \ Radio's scheduler, which made the\nburst miss its start time (late packet,\
      \ then an underflow per packet).\n\nThe block's very first output is one zero\
      \ sample tagged tx_eob. gr-uhd's USRP\nSink opens a timed burst when it starts\
      \ (an empty start-of-burst packet at\nnow + 0.15 s) and never ends it; left\
      \ open, the first real burst would close\nit with a packet whose time has passed\
      \ -- a late (L) event. Ending it at once,\nwell before its time, plays one zero\
      \ sample and reports nothing.\n\"\"\"\nimport numpy as np\nimport pmt\nfrom\
      \ gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    def __init__(self,\
      \ nchan=8, burst_len=32768, amp=0.25, tone_step=1.0 / 64,\n                \
      \ phases_deg=(), amps=()):\n        gr.sync_block.__init__(self, name=\"ZCU216\
      \ tone bursts\", in_sig=None,\n                               out_sig=[np.complex64]\
      \ * int(nchan))\n        self.nchan, self.burst_len = int(nchan), int(burst_len)\n\
      \        n = np.arange(self.burst_len)\n        self._tone = np.exp(2j * np.pi\
      \ * tone_step * n)\n        # per-channel TX phase (degrees) and amplitude (fraction\
      \ of full scale):\n        # plain attributes, so GRC's callbacks (the flowgraph's\
      \ sliders) set them\n        # while it runs; a burst uses the values in force\
      \ when it starts.\n        # Missing entries: 0 degrees, amplitude `amp`.\n\
      \        self.amp = float(amp)\n        self.phases_deg = phases_deg\n     \
      \   self.amps = amps\n        self._key, self._sigs, self._cur = None, None,\
      \ None\n        self.message_port_register_in(pmt.intern(\"fire\"))\n      \
      \  self.set_msg_handler(pmt.intern(\"fire\"), self._fire)\n        self._pending\
      \ = []\n        self._pos = None\n        self._t0 = 0.0\n        self._closed_start\
      \ = False\n\n    def _fire(self, msg):\n        self._pending.append(pmt.to_double(msg))\n\
      \n    def _channel_sigs(self):\n        ph = [float(x) for x in self.phases_deg][:self.nchan]\n\
      \        am = [float(x) for x in self.amps][:self.nchan]\n        ph += [0.0]\
      \ * (self.nchan - len(ph))\n        am += [self.amp] * (self.nchan - len(am))\n\
      \        key = (tuple(ph), tuple(am))\n        if key != self._key:\n      \
      \      self._key = key\n            self._sigs = [(am[k] * np.exp(1j * np.deg2rad(ph[k]))\
      \ * self._tone).astype(np.complex64)\n                          for k in range(self.nchan)]\n\
      \        return self._sigs\n\n    def work(self, input_items, output_items):\n\
      \        if not self._closed_start:\n            # end gr-uhd's start-of-stream\
      \ burst (see the module docstring)\n            self._closed_start = True\n\
      \            for k in range(self.nchan):\n                output_items[k][0]\
      \ = 0\n            self.add_item_tag(0, self.nitems_written(0), pmt.intern(\"\
      tx_eob\"), pmt.PMT_T)\n            return 1\n        if self._pos is None:\n\
      \            if not self._pending:\n                return 0\n            self._t0,\
      \ self._pos = self._pending.pop(0), 0\n            self._cur = self._channel_sigs()\n\
      \        pos = self._pos\n        n = min(len(output_items[0]), self.burst_len\
      \ - pos)\n        for k in range(self.nchan):\n            output_items[k][:n]\
      \ = self._cur[k][pos:pos + n]\n        off = self.nitems_written(0)\n      \
      \  if pos == 0:\n            secs = int(self._t0)\n            self.add_item_tag(0,\
      \ off, pmt.intern(\"tx_sob\"), pmt.PMT_T)\n            self.add_item_tag(0,\
      \ off, pmt.intern(\"tx_time\"),\n                              pmt.make_tuple(pmt.from_uint64(secs),\
      \ pmt.from_double(self._t0 - secs)))\n        if pos + n == self.burst_len:\n\
      \            self.add_item_tag(0, off + n - 1, pmt.intern(\"tx_eob\"), pmt.PMT_T)\n\
      \            self._pos = None\n        else:\n            self._pos = pos +\
      \ n\n        return n\n"
    affinity: ''
    alias: ''
    amp: '0.25'
    amps: '[tx_amp0, tx_amp1, tx_amp2, tx_amp3, tx_amp4, tx_amp5, tx_amp6, tx_amp7]'
    burst_len: burst_len
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: nchan
    phases_deg: '[tx_ph0, tx_ph1, tx_ph2, tx_ph3, tx_ph4, tx_ph5, tx_ph6, tx_ph7]'
    tone_step: tone / samp_rate
  states:
    _io_cache: ('ZCU216 tone bursts', 'blk', [('nchan', '8'), ('burst_len', '32768'),
      ('amp', '0.25'), ('tone_step', '0.015625'), ('phases_deg', '()'), ('amps', '()')],
      [('fire', 'message', 1)], [('0', 'complex', 1), ('1', 'complex', 1), ('2', 'complex',
      1), ('3', 'complex', 1), ('4', 'complex', 1), ('5', 'complex', 1), ('6', 'complex',
      1), ('7', 'complex', 1)], '', ['amp', 'amps', 'burst_len', 'nchan', 'phases_deg'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 280]
    rotation: 0
    state: enabled
